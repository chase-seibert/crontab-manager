@monthly printf '%s\n' alpha beta | xargs -I{} /opt/example/bin/rebuild-index index-992 {} >> /var/log/example/xargs-992.log 2>&1 # EXPECT {"status":"❌","name":"rebuild-index index-992","command":"printf '%s\\n' alpha beta | xargs -I{} /opt/example/bin/rebuild-index index-992 {}","logfiles":["/var/log/example/xargs-992.log"]}
# 0 8-18/2 * * 1-5 nohup /opt/example/bin/background-job job-993 >> /var/log/example/nohup-993.log 2>&1 & # EXPECT {"status":"❌","name":"background-job job-993","command":"nohup /opt/example/bin/background-job job-993 &","logfiles":["/var/log/example/nohup-993.log"]}
0 2 L * * systemd-run --unit example-994 --on-active=1m /opt/example/bin/transient-job job-994 >> /var/log/example/systemd-994.log 2>&1 # EXPECT {"status":"❌","name":"transient-job job-994","command":"systemd-run --unit example-994 --on-active=1m /opt/example/bin/transient-job job-994","logfiles":["/var/log/example/systemd-994.log"]}
0 * * * * launchctl asuser 501 /opt/example/bin/user-session-job job-995 >> /var/log/example/launchctl-995.log 2>&1 # EXPECT {"status":"❌","name":"user-session-job job-995","command":"launchctl asuser 501 /opt/example/bin/user-session-job job-995","logfiles":["/var/log/example/launchctl-995.log"]}
30 4 1 * * su -s /bin/sh example -c '/opt/example/bin/su-job job-996' >> /var/log/example/su-996.log 2>&1 # EXPECT {"status":"❌","name":"su-job job-996","command":"su -s /bin/sh example -c '/opt/example/bin/su-job job-996'","logfiles":["/var/log/example/su-996.log"]}
5,35 * * * * /bin/bash -lc 'cd /srv/example/nested-make-997 && make refresh >> /var/log/example/nested-make-997.log 2>&1' # EXPECT {"status":"❌","name":"nested-make-997 refresh","command":"/bin/bash -lc 'cd /srv/example/nested-make-997 && make refresh >> /var/log/example/nested-make-997.log 2>&1'","logfiles":["/var/log/example/nested-make-997.log"]}
@daily LOG_FILE=/var/log/example/env-log-998.log /opt/example/bin/env-log-job job-998 >> "$LOG_FILE" 2>&1 # EXPECT {"status":"❌","name":"env-log-job job-998","command":"LOG_FILE=/var/log/example/env-log-998.log /opt/example/bin/env-log-job job-998","logfiles":["/var/log/example/env-log-998.log"]}
@reboot /opt/example/bin/date-log job-999 >> /var/log/example/date-log-$(date +\%F)-999.log 2>&1 # EXPECT {"status":"❌","name":"date-log job-999","command":"/opt/example/bin/date-log job-999","logfiles":["/var/log/example/date-log-$(date +\\%F)-999.log"]}
0 12 * JAN,MAR,SEP MON-FRI /opt/example/bin/descriptor-job job-1000 3>&1 1>> /var/log/example/fd-1000.log 2>&1 # EXPECT {"status":"❌","name":"descriptor-job job-1000","command":"/opt/example/bin/descriptor-job job-1000","logfiles":["/var/log/example/fd-1000.log"]}
